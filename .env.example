# =====================================================================
# Banking Modern Data Stack - Environment Configuration Template
# Copy this file to .env and replace placeholder values with your credentials
# =====================================================================

# ---------------------------------------------------------------------
# PostgreSQL (Banking OLTP Source Database)
# ---------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=banking

# ---------------------------------------------------------------------
# MinIO (S3-Compatible Data Lakehouse Storage)
# ---------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=raw
MINIO_LOCAL_DIR=/tmp/minio_downloads

# ---------------------------------------------------------------------
# Apache Kafka & Debezium Connect
# ---------------------------------------------------------------------
KAFKA_BOOTSTRAP=localhost:29092
KAFKA_GROUP=minio-landing-group
DEBEZIUM_CONNECT_URL=http://localhost:8083/connectors

# ---------------------------------------------------------------------
# Apache Airflow (Orchestration & Metadata DB)
# ---------------------------------------------------------------------
AIRFLOW_DB_USER=admin
AIRFLOW_DB_PASSWORD=admin
AIRFLOW_DB_NAME=airflow
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_ADMIN_EMAIL=admin@example.com

# ---------------------------------------------------------------------
# Snowflake Data Warehouse
# ---------------------------------------------------------------------
SNOWFLAKE_ACCOUNT=your_snowflake_account.region
SNOWFLAKE_USER=your_snowflake_username
SNOWFLAKE_PASSWORD=your_snowflake_password
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DB=BANKING
SNOWFLAKE_SCHEMA=RAW
SNOWFLAKE_ANALYTICS_SCHEMA=ANALYTICS

# ---------------------------------------------------------------------
# dbt Configuration
# ---------------------------------------------------------------------
DBT_PROFILES_DIR=./banking_dbt
DBT_TARGET=dev
